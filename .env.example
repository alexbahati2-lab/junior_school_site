# Django Settings
SECRET_KEY=your-secret-key-here-generate-a-new-one-for-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1

# Database (for Render deployment)
# PostgreSQL URL format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/junior_school_db

# CSRF and Security
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
